<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link
      href="https://unpkg.com/tailwindcss/dist/tailwind.min.css"
      rel="stylesheet"
    />

    <script src="<%=server%>/public/JsBarcode.all.min.js"></script>

    <title>Relatório</title>
  </head>
  <style>
    body ,
    table {
      background-color: #fff;
    }

    body div,
    body {
      width: 100%;
      height: 100%;
    }
    /* .table1 {
      width: 30%;
    } */

    table {
      width: 100%;
    }

    th {
      text-align: left;
    }
    th + th {
      margin-right: 0.3rem;
    }
    div {
      flex: 1;
    }

    td,
    th {
      text-align: center;
    }

    .short-cell {
      overflow: hidden;
      text-overflow: ellipsis;
      display: -webkit-box;
      -webkit-line-clamp: 1; /* number of lines to show */
      -webkit-box-orient: vertical;
    }


    .right {
      display: inline;
      width: 50%;
      float: right;
    }

    .left {
      display: inline;
        width: 50%;
        float: left;
    }

    .barcode {
      width: 40%;
      height: 100%;
      margin: 0 auto;
      /* float:right; */
      displayValue: false,
    }

    .text-3xl {
      text-align: center;
      font-size: 3rem;
    }

    body {
      margin-left: 2px;
      margin-right: 2px;
      margin-top: 10px;
    }

    header {
      padding: 1.2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background-color: black;
      color: white;
    }

    .img-logo svg {
      width: 50%;
      height: 50%;
    }

    .info-hd,
    .info-hd div {
      display: flex;
      align-items: center;
    }
    .info-hd h1 {
      margin-right: 1rem;
    }

    .info-hd div {
      padding: 0.5rem;
      background-color: white;
      color: black;
    }

    .td {
      border-bottom: 1px solid black;
    }

    .page {
    width: 21cm;
    min-height: 20.7cm;
    padding: 2cm;
    margin: 1cm auto;


    }

    @page {
    size: A4;
    margin: 0;
    }


    body {
      display: flex;
      flex-direction: column;
      min-height: 100%;
    }

    #content {
      flex: 1;
      padding: 20px;
    }
  </style>
  <body>
    <% if (employee.user.length > 0) { %>
    <div>

      <div class="left">
        <svg
        id="barcode2"
        jsbarcode-format="code128"
        jsbarcode-value="<%= employee.user %>"
        jsbarcode-textmargin="0"
        jsbarcode-fontoptions="bold"
      >
        asdasd
      </svg>

      </div>
      <div class="right">
        <svg
          id="barcode3"
          jsbarcode-format="code128"
          jsbarcode-value="<%= employee.password %>"
          jsbarcode-textmargin="0"
          jsbarcode-fontoptions="bold"
          jsbarcode-value
        >
          asdasd
        </svg>
      </div>
    </div>
    <% } %>

  </body>

  <script>
    JsBarcode('.barcode').init();
    JsBarcode("#barcode2", '<%= employee.user %>', {
      format: "code128",
      displayValue: true,
      height: 50,
      width: 1
    });

    JsBarcode("#barcode3", '<%= employee.password %>', {
      format: "code128",
      displayValue: false,
      height: 50,
      width: 1
    });
  </script>
</html>
